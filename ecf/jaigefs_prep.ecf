#PBS -N aigefs_prep_%MEMBER%_%CYC%
#PBS -j oe
#PBS -S /bin/bash
#PBS -q %QUEUE%
#PBS -l walltime=00:30:00
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l place=shared,select=1:ncpus=1:mem=10GB
#PBS -l debug=true

export model=aigefs

%include <head.h>
%include <envir-p1.h>

export cyc=%CYC%

module load intel/${intel_ver:?}
module load wgrib2/${wgrib2_ver:?}
module load libjpeg-turbo/${libjpeg_turbo_ver:?}

source ${HOMEaigefs}/venv/bin/activate

module list

export MEMBER=%MEMBER%          # mem000-mem030
export GEFS_MEMBER=ge%GEFS_MEMBER%  # c00, p01-p30

${HOMEaigefs}/jobs/JAIGEFS_PREP

if [[ $? -ne 0 ]]; then
    ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT"
    ecflow_client --abort
    exit
fi

%include <tail.h>
%manual
###############################################################################
#
#  PURPOSE: Prepare data for running a machine learning model with GEFS inputs
#
###############################################################################
%end
